# Образец deploy/docker/env/db.env — переменные контейнера db (PostgreSQL).
# Настоящий файл создаёт make container-env (случайные пароли, права 600).
# Пароли применяются только при создании нового volume базы данных.
POSTGRES_PASSWORD=ПАРОЛЬ_СУПЕРПОЛЬЗОВАТЕЛЯ_POSTGRES
WH_OWNER_PASSWORD=ПАРОЛЬ_WH_OWNER
WH_APP_PASSWORD=ПАРОЛЬ_WH_APP
