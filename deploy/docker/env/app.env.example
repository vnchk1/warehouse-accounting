# Образец deploy/docker/env/app.env — переменные контейнеров app и migrate.
# Настоящий файл создаёт make container-env (случайные значения, права 600).
# Значения без пробелов и кавычек. Хост базы — имя сервиса db в сети Compose.
DATABASE_URL=postgresql+psycopg://wh_app:ПАРОЛЬ_WH_APP@db:5432/warehouse
SECRET_KEY=СЛУЧАЙНАЯ_СТРОКА_64_СИМВОЛА
ADMIN_LOGIN=admin
ADMIN_PASSWORD=ПАРОЛЬ_ВХОДА_В_ПРИЛОЖЕНИЕ
