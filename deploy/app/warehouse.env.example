# Образец /etc/warehouse/warehouse.env (владелец root:root, права 600).
# Настоящий файл создаёт setup_app.sh; в репозиторий он не попадает.
# Значения без пробелов и кавычек: файл читают и systemd, и bash.
DATABASE_URL=postgresql+psycopg://wh_app:ПАРОЛЬ_WH_APP@192.168.253.131:5432/warehouse
SECRET_KEY=СЛУЧАЙНАЯ_СТРОКА_64_СИМВОЛА
ADMIN_LOGIN=admin
ADMIN_PASSWORD=ПАРОЛЬ_ВХОДА_В_ПРИЛОЖЕНИЕ
APP_HOST=0.0.0.0
APP_PORT=8000
SESSION_HOURS=12
PASSWORD_MIN_LENGTH=8
