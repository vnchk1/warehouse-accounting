# секреты и локальная конфигурация
.env

# виртуальное окружение и кэши Python; инструменты проверки (make tools)
.tools/
.venv/
.venv
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# отчёты проверок (make verify) и резервные копии базы (make backup)
reports/
.coverage
backups/
*.dump

# среды разработки и ОС
.idea/
.vscode/
.DS_Store

# журналы
*.log

# пароли контейнерного окружения (создаёт make container-env)
deploy/docker/env/*.env
