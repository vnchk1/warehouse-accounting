# Пример конфигурации. make setup создаёт по нему файл .env со случайными
# паролями; вручную: скопируйте в .env и подставьте свои значения.
# Файл .env в репозиторий не попадает (см. .gitignore).

# Подключение к PostgreSQL
DATABASE_URL=postgresql+psycopg://warehouse:ЗАМЕНИТЕ_ПАРОЛЬ@localhost:5432/warehouse

# Ключ подписи файла cookie сеанса (не менее 16 символов).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ

# Учётная запись администратора, создаваемая командой make seed
ADMIN_LOGIN=admin
ADMIN_PASSWORD=ЗАМЕНИТЕ_ПАРОЛЬ

# Необязательные параметры (показаны значения по умолчанию)
APP_HOST=127.0.0.1
APP_PORT=8000
SESSION_HOURS=12
PASSWORD_MIN_LENGTH=8

# Отдельная база для автоматических тестов (make test). Имя обязательно
# оканчивается на _test: тесты очищают таблицы, рабочую базу так не задеть.
# Роли нужно право CREATEDB — тесты миграций создают временные базы.
TEST_DATABASE_URL=postgresql+psycopg://warehouse:ЗАМЕНИТЕ_ПАРОЛЬ@localhost:5432/warehouse_test
